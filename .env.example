# ============================================================
# Supabase - pengelolaan data POS (pengganti Convex)
# Salin file ini menjadi .env.local lalu isi nilai aslinya.
# Ambil dari: Supabase Dashboard -> Project Settings -> API
# Project URL  -> VITE_SUPABASE_URL
# anon public  -> VITE_SUPABASE_ANON_KEY
# CATATAN: JANGAN pernah memasukkan service_role key di sini
# (kunci itu master dan hanya untuk server-side).
# ============================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
